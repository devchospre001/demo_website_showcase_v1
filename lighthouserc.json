{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4321/demo_website_showcase_v1/",
        "http://localhost:4321/demo_website_showcase_v1/services/paver-patios/",
        "http://localhost:4321/demo_website_showcase_v1/projects/",
        "http://localhost:4321/demo_website_showcase_v1/contact/"
      ],
      "numberOfRuns": 1,
      "startServerCommand": "pnpm preview",
      "startServerReadyPattern": "localhost:4321"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
