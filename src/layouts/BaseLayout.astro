---
import { Font } from "astro:assets";
import SiteFooter from "../components/sections/SiteFooter.astro";
import SiteHeader from "../components/sections/SiteHeader.astro";
import { site } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** URL of the above-the-fold image to preload (hero). */
  preloadImage?: string;
  /** Keep utility pages (like /quote-demo/) out of search results. */
  noindex?: boolean;
}

const { title, description, preloadImage, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// LocalBusiness JSON-LD, generated only from src/lib/site.ts.
// No aggregateRating: the demo rating is a sample, not real reviews.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: site.name,
  legalName: site.legalName,
  description: site.tagline,
  url: Astro.site?.href,
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.founded),
  areaServed: site.areas.map((city) => ({ "@type": "City", name: `${city}, FL` })),
  openingHoursSpecification: site.hours
    .filter((h) => h.open && h.close)
    .map((h) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: h.open,
      closes: h.close,
    })),
};
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#231E19" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <Font cssVariable="--font-instrument" preload />
    <Font cssVariable="--font-cormorant" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-button focus:bg-brand focus:px-5 focus:py-3 focus:font-semibold focus:text-on-brand"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
