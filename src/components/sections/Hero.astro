---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";
import Rating from "../ui/Rating.astro";
import { phoneDisplay, phoneHref, quoteHref, site } from "../../lib/site";

// Concept: 640px tall on phones (copy pinned to the bottom), 760px on desktop (copy 128px from the top).
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  leadMobile: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { eyebrow, title, lead, leadMobile, image, imageAlt } = Astro.props;
---

<section class="on-dark relative isolate h-[640px] overflow-hidden bg-night text-white lg:h-[760px]">
  <Image
    src={image}
    alt={imageAlt}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover object-[35%_50%] lg:object-center"
  />
  <div
    class="absolute inset-0 -z-10 bg-linear-to-b from-scrim/20 via-scrim/55 via-45% to-scrim/90 lg:bg-linear-to-r lg:from-scrim/82 lg:via-scrim/62 lg:via-42% lg:to-scrim/0 lg:to-70%"
  >
  </div>

  <Container class="relative h-full">
    <div
      class="absolute inset-x-(--gutter) bottom-8 flex flex-col gap-4 lg:top-32 lg:right-auto lg:bottom-auto lg:w-[660px] lg:gap-6"
    >
      <p class="text-xs font-semibold tracking-[0.18em] text-sand-ink uppercase lg:text-sm lg:tracking-[0.2em]">{eyebrow}</p>
      <h1 class="text-5xl leading-none lg:text-[84px] lg:leading-[0.98] lg:tracking-[-0.01em]">{title}</h1>
      <p class="text-[17px] leading-[1.55] text-on-photo lg:hidden">{leadMobile}</p>
      <p class="hidden max-w-[560px] text-xl leading-[1.6] text-on-photo lg:block">{lead}</p>

      <div class="flex flex-col gap-4 lg:mt-2 lg:flex-row">
        <Button href={quoteHref} variant="sand" size="lg">
          Get a free quote
          <Icon name="arrow" size={18} class="hidden lg:block" />
        </Button>
        <Button href={phoneHref} variant="outline-light" size="lg">Call {phoneDisplay}</Button>
      </div>

      <p class="text-center text-sm text-on-photo-muted lg:hidden">
        <span aria-hidden="true">★★★★★ </span>{site.rating.value} out of 5 · Licensed &amp; insured
      </p>
      <div class="mt-3 hidden items-center gap-[22px] text-[15px] text-on-photo-muted lg:flex">
        <Rating value={site.rating.value}>{site.rating.value} out of 5 · {site.rating.count} reviews</Rating>
        <span class="h-[18px] w-px shrink-0 bg-white/35" aria-hidden="true"></span>
        {site.insured && <span>Licensed &amp; insured</span>}
        <span class="h-[18px] w-px shrink-0 bg-white/35" aria-hidden="true"></span>
        <span>5-year workmanship warranty</span>
      </div>
    </div>
  </Container>
  <p class="absolute right-6 bottom-[18px] hidden text-xs tracking-[0.04em] text-white/75 lg:block">Concept illustration</p>
</section>
