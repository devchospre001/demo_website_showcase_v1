---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Eyebrow from "../ui/Eyebrow.astro";
import Section from "../ui/Section.astro";

// Labeled side-by-side photos. No drag slider (docs/design-system.md section 6).
// Concept: phones stack the photos and end with a one-line summary; desktop shows a fact list.
interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { before, images, city, scope, scopeShort, summary, duration } = project.data;
const after = images[0]!;
const badge = "absolute top-3 left-3 rounded px-2.5 py-1.5 text-xs font-semibold tracking-[0.12em] text-ink lg:top-4 lg:left-4 lg:px-3 lg:py-2 lg:text-[13px]";
const photo = "block h-[220px] w-full rounded-card object-cover lg:h-[440px]";
---

{
  before && (
    <Section bg="brand" labelledby="before-after-title">
      <div class="flex flex-col gap-4 lg:gap-12">
        <div class="grid gap-4 lg:grid-cols-2 lg:items-end lg:gap-20">
          <div class="flex flex-col gap-4">
            <Eyebrow dark>Before &amp; after</Eyebrow>
            <h2 id="before-after-title" class="text-[34px] leading-[1.05] lg:text-[56px]">
              From patchy lawn to the room you use every evening.
            </h2>
          </div>
          <dl class="hidden grid-cols-3 gap-6 text-base lg:grid">
            <div class="flex flex-col gap-1 border-t border-white/25 pt-3.5">
              <dt class="text-on-night">Location</dt>
              <dd class="font-semibold">{city}</dd>
            </div>
            <div class="flex flex-col gap-1 border-t border-white/25 pt-3.5">
              <dt class="text-on-night">Scope</dt>
              <dd class="font-semibold">{scope ?? summary}</dd>
            </div>
            <div class="flex flex-col gap-1 border-t border-white/25 pt-3.5">
              <dt class="text-on-night">Timeline</dt>
              <dd class="font-semibold">{duration}</dd>
            </div>
          </dl>
        </div>
        <div class="grid gap-4 lg:grid-cols-2 lg:gap-5">
          <figure class="relative">
            <Image src={before.src} alt={before.alt} class={photo} />
            <figcaption class:list={[badge, "bg-surface"]}>BEFORE</figcaption>
          </figure>
          <figure class="relative">
            <Image src={after.src} alt={after.alt} class={photo} />
            <figcaption class:list={[badge, "bg-accent"]}>AFTER</figcaption>
          </figure>
        </div>
        <p class="text-[15px] text-on-night lg:hidden">
          {city} · {scopeShort ?? scope ?? summary} · {duration}
        </p>
      </div>
    </Section>
  )
}
