---
// Stars + text value. Never stars alone.
interface Props {
  value: number;
  class?: string;
}
const { value, class: className } = Astro.props;
const full = Math.round(value);
---

<span class:list={["inline-flex items-center gap-1.5", className]}>
  <span class="flex gap-0.5 text-accent" aria-hidden="true">
    {
      Array.from({ length: 5 }, (_, i) => (
        <svg width="16" height="16" viewBox="0 0 24 24" class:list={[i < full ? "fill-current" : "fill-none stroke-current"]}>
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
        </svg>
      ))
    }
  </span>
  <span><slot>{value} out of 5</slot></span>
</span>
