---
import type { HTMLAttributes } from "astro/types";

// Renders <a> when given href, else <button>. Minimum 44x44px, visible focus ring.
// Sizes follow the concept: md = 48px/16px text, lg = 54px on phones and 56px on desktop, 17px text.
type Variant = "primary" | "secondary" | "sand" | "outline-light";

interface Props {
  href?: string;
  variant?: Variant;
  size?: "md" | "lg";
  type?: "button" | "submit";
  full?: boolean;
  class?: string;
  "aria-label"?: string;
  rel?: HTMLAttributes<"a">["rel"];
  target?: HTMLAttributes<"a">["target"];
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  full = false,
  class: className,
  ...rest
} = Astro.props;

const variants: Record<Variant, string> = {
  primary: "bg-brand text-on-brand hover:bg-brand-strong hover:text-on-brand",
  secondary: "border-[1.5px] border-brand text-brand hover:bg-brand hover:text-on-brand",
  sand: "bg-accent text-ink hover:bg-sand-ink hover:text-ink",
  "outline-light": "border-[1.5px] border-white/80 text-white hover:bg-white/10 hover:text-white",
};

const sizes = {
  md: "min-h-12 text-base",
  lg: "min-h-[54px] text-[17px] lg:min-h-14",
};
const padding = size === "md" ? "px-6" : variant === "outline-light" ? "px-[26px]" : "px-7";

// A caller that passes "hidden" controls display itself (e.g. "hidden lg:inline-flex");
// otherwise the utility order would let inline-flex win over hidden.
const callerHides = (className ?? "").split(/\s+/).includes("hidden");

const classes = [
  !callerHides && "inline-flex",
  "items-center justify-center gap-2.5 rounded-button font-semibold leading-[normal] no-underline transition-colors",
  sizes[size],
  padding,
  variants[variant],
  full && "w-full",
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
