---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Section from "../components/ui/Section.astro";
import { quoteHref, site } from "../lib/site";
import { url } from "../lib/url";
---

<BaseLayout title={`Page not found | ${site.name}`} description="This page doesn’t exist." noindex>
  <Section>
    <div class="flex max-w-2xl flex-col gap-5">
      <h1 class="text-5xl md:text-6xl">We couldn’t find that page</h1>
      <p class="text-lg leading-relaxed text-ink-soft">The link may be old or mistyped.</p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href={url("/")} size="lg">Go to the home page</Button>
        <Button href={quoteHref} variant="secondary" size="lg">Get a free quote</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
