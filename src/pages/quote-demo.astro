---
// Where the demo form lands when JavaScript is off. The form sends no data (inputs have no name).
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Section from "../components/ui/Section.astro";
import { phoneDisplay, phoneHref, site } from "../lib/site";
import { url } from "../lib/url";
---

<BaseLayout
  title={`Concept site | ${site.name}`}
  description="This is a concept site. The quote form doesn’t send anything."
  noindex
>
  <Section>
    <div class="flex max-w-2xl flex-col gap-5">
      <h1 class="text-5xl md:text-6xl">Thanks! Nothing was sent.</h1>
      <p class="text-lg leading-relaxed text-ink-soft">
        {site.name} is a fictional business on a concept site by {site.studio.name}, so this form doesn’t
        send your details anywhere. On a real site, the business would call you back within one business day.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href={url("/")} size="lg">Back to the home page</Button>
        <Button href={phoneHref} variant="secondary" size="lg">Call {phoneDisplay}</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
